; ATOMISTIC AMBER99SB*-ILDNP, sampling matched to CG cg_md.mdp.
; Variant: trajectory output excludes water (compressed-x-grps = Protein).
;
integrator             = md
dt                     = 0.002
nsteps                 = 55000000
nstcomm                = 275
;
nstxout                = 0
nstvout                = 0
nstfout                = 0
nstlog                 = 2750
nstenergy              = 2750
nstxout-compressed     = 2750
compressed-x-precision = 1000
compressed-x-grps      = Protein        ; water NOT exported in xtc
;
cutoff-scheme          = Verlet
nstlist                = 55
pbc                    = xyz
;
continuation           = yes
constraint_algorithm   = lincs
constraints            = h-bonds
;
rcoulomb               = 1.0
rvdw                   = 1.0
coulombtype            = PME
fourierspacing         = 0.16
;
tcoupl                 = V-rescale
tc-grps                = Protein Non-Protein
tau_t                  = 0.1   0.1
ref_t                  = 303   303
;
pcoupl                 = Parrinello-Rahman
pcoupltype             = isotropic
tau_p                  = 2.0
ref_p                  = 1.0
compressibility        = 4.5e-5
refcoord_scaling       = com
;
DispCorr               = EnerPres
gen_vel                = no
