; STANDARD MD INPUT OPTIONS FOR ATOMISTIC AMBER99SB*-ILDNP
; Sampling matched to CG cg_md.mdp (110 ns total, ~0.11 ps neighbor-list interval,
; energy/log/xtc every 5.5 ps), so AA and CG output frames align in physical time.
;
integrator             = md
dt                     = 0.002          ; 2 fs (physical max for AA without VS/HMR)
nsteps                 = 55000000       ; 110 ns total, matches CG (0.0055 * 20e6)
nstcomm                = 275            ; ~0.55 ps, matches CG (100 * 0.0055)
;
nstxout                = 0
nstvout                = 0
nstfout                = 0
nstlog                 = 2750           ; 5.5 ps, matches CG (1000 * 0.0055)
nstenergy              = 2750
nstxout-compressed     = 2750
compressed-x-precision = 1000
compressed-x-grps      = System         ; include water (matches CG default)
;
cutoff-scheme          = Verlet
nstlist                = 55             ; ~0.11 ps update, matches CG (20 * 0.0055)
pbc                    = xyz
;
continuation           = yes
constraint_algorithm   = lincs
constraints            = h-bonds
;
rcoulomb               = 1.0
rvdw                   = 1.0
coulombtype            = PME
fourierspacing         = 0.16
;
tcoupl                 = V-rescale
tc-grps                = Protein Non-Protein
tau_t                  = 0.1   0.1
ref_t                  = 303   303      ; matches CG ref_t
;
pcoupl                 = Parrinello-Rahman
pcoupltype             = isotropic
tau_p                  = 2.0
ref_p                  = 1.0
compressibility        = 4.5e-5
refcoord_scaling       = com
;
DispCorr               = EnerPres
gen_vel                = no
